+
+/* DPMS: zwlr_output_power_management_v1. Only toggles "enabled"; the output stays in the
+ * layout and scene, so input mapping and view positions are untouched. */
+void
+handle_output_power_set_mode(struct wl_listener *listener, void *data)
+{
+	struct wlr_output_power_v1_set_mode_event *event = data;
+	struct wlr_output *wlr_output = event->output;
+	bool enable = event->mode == ZWLR_OUTPUT_POWER_V1_MODE_ON;
+
+	if (wlr_output->enabled == enable) {
+		return;
+	}
+
+	struct wlr_output_state state = {0};
+	wlr_output_state_set_enabled(&state, enable);
+	if (!wlr_output_commit_state(wlr_output, &state)) {
+		wlr_log(WLR_ERROR, "Failed to set power mode of output %s", wlr_output->name);
+	} else if (enable) {
+		wlr_output_schedule_frame(wlr_output);
+	}
+	wlr_output_state_finish(&state);
+}
